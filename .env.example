# ==============================================================================
# AI Job Hunter Pro - LLM 中转站与大模型配置模板
# ==============================================================================

# 1. OpenAI / DeepSeek / 聚合中转站 API 配置 (支持任何兼容 OpenAI 格式的中转站)
# 如您使用的是 One-API / New-API / 硅基流动 / 官方 DeepSeek，填入对应地址和 Key 即可：
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 2. 默认优先主调用模型
PRIMARY_MODEL=deepseek-chat

# 3. 备选故障转移模型链 (英文逗号分隔，当主模型 400/429/限流时毫秒级自动切换)
FALLBACK_MODELS=deepseek-chat,qwen2.5-72b-instruct,gemini-2.0-flash,glm-4-flash,doubao-lite-4k

# 4. 超时时间 (秒)
TIMEOUT_SECONDS=10.0
