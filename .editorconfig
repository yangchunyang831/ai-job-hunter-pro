# ==============================================================================
# EditorConfig - Cross-Platform Encoding & Line Ending Standard
# ==============================================================================

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.bat]
end_of_line = crlf
charset = gbk

[*.cmd]
end_of_line = crlf
charset = gbk

[*.ps1]
end_of_line = crlf
charset = utf-8

[*.md]
trim_trailing_whitespace = false
